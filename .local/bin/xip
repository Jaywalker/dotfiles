#!/bin/sh
# Arch Requirements: pbzx, (xar)

[ -z "$1" ] && echo "usage: xip [-xc] [archive]" && exit
if [ "$1" == "-x" ]; then
	[ -z "$1" ] && echo "usage: xip -x /path/to/archive.xip" && exit
	PBZX="$(which pbzx)" && [ ! -x "$PBZX" ] && echo "$PBZX not found." && exit
	[ ! -f "$2" ] && echo "$2 not found." && exit
	[ -f "Content" ] || [ -f "Metadata" ] && echo "Content or Metadata already exists." && exit
	#pkgutil --check-signature "$1" &&
	xar -xf "$2" && "$PBZX" -n Content | cpio -idv
	rm "Content" "Metadata"
fi
