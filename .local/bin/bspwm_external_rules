if [ "$window_class" == "Zathura" ] || [ "$window_class" == "Surf" ]; then
	echo "state=tiled"
elif [ "$window_class" == "Slack" ]; then
	echo "$window_title" | grep "Slack call with " >/dev/null && echo "state=tiled"
elif [ "$window_class" == "zoom" ]; then
	if [ "$window_title" == "zoom" ]; then
		# This section adjusts the windows that are notifications to be floating windows (ex. audio device changes, host/co-host changes, etc).
		echo "state=floating"
		# Here we use an external script to screenshot, kill, and OCR the text from the window into a notifyd alert
		~/.local/bin/bspwm_zoom_to_notify "$window_id_hex" &
	fi
# Check if the window is mpv
elif [[ "$class" == "mpv" ]]; then
	# Check if the window is in floating mode using xprop
	state=$(xprop -id "$wid" _NET_WM_STATE | grep _NET_WM_STATE_FLOATING)
	if [[ -n "$state" ]]; then
		# Apply size and position (e.g., 800x450, centered on a 1920x1080 screen)
		echo "state=floating rectangle=539x301+7-7"
	fi
fi
