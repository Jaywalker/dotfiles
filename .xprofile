#!/bin/sh

#setxkbmap workman &                     	# Even though this is set in vconsole.conf, it is necessary to call here for sxhkd to get things right
sxhkd -m 10 & 					# Bind keys
setbg &						# Set the background
xset r rate 300 50 &				# Speed xrate up
xset -r 48 &					# Disable repeating on ' for mumble hotkey
unclutter &					# Remove mouse when idle
xcompmgr &					# xcompmgr for transparency
nm-applet &					# Show connection state
dunst &						# dunst for notifications
redshift -l 37.208937:-93.292339 &		# Color shift with time
pipewire &
wireplumber &
pipewire-pulse &
